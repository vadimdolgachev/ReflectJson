set(work "${BUILD_DIR}/integration/${MODE}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()
set(options)
set(config_options)
if(CONFIG)
    list(APPEND config_options --config "${CONFIG}")
endif()
if(MODE STREQUAL "installed")
    run_checked("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${work}/stage" ${config_options})
    file(RENAME "${work}/stage" "${work}/relocated")
    file(GLOB_RECURSE exports "${work}/relocated/*.cmake")
    foreach(export IN LISTS exports)
        file(READ "${export}" contents)
        foreach(forbidden IN ITEMS "${SOURCE_DIR}" "${BUILD_DIR}")
            string(FIND "${contents}" "${forbidden}" position)
            if(NOT position EQUAL -1)
                message(FATAL_ERROR "Non-relocatable export ${export}: ${forbidden}")
            endif()
        endforeach()
    endforeach()
    list(APPEND options "-DCMAKE_PREFIX_PATH=${work}/relocated")
else()
    list(APPEND options "-DReflectJson_SOURCE=${SOURCE_DIR}")
endif()
run_checked("${CMAKE_COMMAND}" -S "${CONSUMER_SOURCE}" -B "${work}/build"
    "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DCMAKE_CXX_FLAGS=${CXX_FLAGS}"
    "-DCMAKE_BUILD_TYPE=${BUILD_TYPE}" "-DCMAKE_BUILD_RPATH=${RUNTIME_DIR}" ${options})
run_checked("${CMAKE_COMMAND}" --build "${work}/build" ${config_options} --parallel 2)
set(program "${work}/build/consumer")
if(EXISTS "${work}/build/${CONFIG}/consumer")
    set(program "${work}/build/${CONFIG}/consumer")
endif()
run_checked("${program}")
