cmake_minimum_required(VERSION 3.30)
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE documents ERROR_VARIABLE errors)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Fixture checks failed:\n${errors}")
endif()
file(READ "${EXPECTED}" expected)
string(JSON count LENGTH "${documents}")
string(JSON expected_count LENGTH "${expected}")
math(EXPR last "${count} - 1")
set(matched 0)
set(numbers 0)
set(names)
foreach(index RANGE 0 ${last})
    string(JSON name GET "${documents}" ${index} name)
    if(name IN_LIST names)
        message(FATAL_ERROR "Duplicate fixture ${name}")
    endif()
    list(APPEND names "${name}")
    string(JSON actual GET "${documents}" ${index} document)
    if(name MATCHES "^(float|double|long_double)_[0-7]$")
        # C++ checks exact values and zero signs; CMake's numeric equality
        # cannot verify those properties.
        math(EXPR numbers "${numbers} + 1")
        continue()
    endif()
    string(JSON golden ERROR_VARIABLE error GET "${expected}" "${name}")
    if(NOT error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Missing fixture ${name}: ${error}")
    endif()
    string(JSON equal EQUAL "${actual}" "${golden}")
    if(NOT equal)
        message(FATAL_ERROR "JSON fixture ${name} differs:\n${actual}\nexpected:\n${golden}")
    endif()
    math(EXPR matched "${matched} + 1")
endforeach()
if(NOT matched EQUAL expected_count OR NOT numbers EQUAL 24)
    message(FATAL_ERROR "Incomplete coverage: ${matched}/${expected_count} JSON fixtures, ${numbers}/24 numbers")
endif()
message(STATUS "Validated ${matched} JSON trees and ${numbers} native numeric round-trips")
